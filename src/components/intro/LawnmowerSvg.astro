---
// Wheel geometry constants — the blade guard path depends on these.
// Left wheel: cx=68, r=24 → outer edge x=44
// Right wheel: cx=136, r=24 → outer edge x=160
// Wheel center y=95; body bottom y=92
// Guard midpoint x = (68+136)/2 = 102
---

<svg viewBox="0 0 220 130" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <!-- Blade guard / deck skirt — drawn first so wheels render on top -->
  <path
    d="M 44 90 Q 44 118 102 118 Q 160 118 160 90"
    fill="#2a5a20" stroke="#1e4018" stroke-width="1.5"
  />

  <!-- Main deck / body -->
  <rect x="45" y="48" width="100" height="44" rx="8" fill="#3d7a30" stroke="#2a5520" stroke-width="1.5"/>

  <!-- Engine block -->
  <rect x="78" y="30" width="46" height="28" rx="5" fill="#2a5520" stroke="#1e4018" stroke-width="1.5"/>

  <!-- Exhaust pipe -->
  <rect x="118" y="22" width="7" height="17" rx="3" fill="#1a1a1a" stroke="#444" stroke-width="1"/>
  <ellipse cx="121" cy="22" rx="5" ry="3" fill="#111" stroke="#333" stroke-width="1"/>

  <!-- Handle -->
  <path d="M 135 58 L 185 30" stroke="#4a6840" stroke-width="4" stroke-linecap="round"/>
  <path d="M 183 30 L 205 30" stroke="#5a7850" stroke-width="5" stroke-linecap="round"/>

  <!-- Left wheel -->
  <circle cx="68" cy="95" r="24" fill="#1a1a1a" stroke="#555" stroke-width="2"/>
  <circle cx="68" cy="95" r="15" fill="none" stroke="#3a3a3a" stroke-width="3"/>
  <circle cx="68" cy="95" r="7" fill="#2d2d2d" stroke="#666" stroke-width="1.5"/>

  <!-- Right wheel -->
  <circle cx="136" cy="95" r="24" fill="#1a1a1a" stroke="#555" stroke-width="2"/>
  <circle cx="136" cy="95" r="15" fill="none" stroke="#3a3a3a" stroke-width="3"/>
  <circle cx="136" cy="95" r="7" fill="#2d2d2d" stroke="#666" stroke-width="1.5"/>

  <!-- Pullcord hole on engine (used to anchor the cord UI element) -->
  <circle cx="88" cy="40" r="4" fill="#1e4018" stroke="#4a7a40" stroke-width="1"/>
</svg>
