---
// Detailed push mower — side profile facing left
// Ripcord anchor at (~155, 42) — inline with handle angle
// Viewbox: 240×140, wheels at y≈110
---

<svg viewBox="0 0 240 140" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block;">
  <defs>
    <!-- Wheel tread pattern -->
    <pattern id="tread" width="6" height="6" patternUnits="userSpaceOnUse">
      <rect width="6" height="6" fill="#1a1a1a"/>
      <rect x="1" y="0" width="4" height="2" fill="#2a2a2a"/>
      <rect x="1" y="4" width="4" height="2" fill="#2a2a2a"/>
    </pattern>
    <!-- Grass texture for chute -->
    <linearGradient id="grassGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#4a8a3a"/>
      <stop offset="100%" stop-color="#2d5a20"/>
    </linearGradient>
    <!-- Metal sheen -->
    <linearGradient id="metalSheen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#666"/>
      <stop offset="50%" stop-color="#888"/>
      <stop offset="100%" stop-color="#555"/>
    </linearGradient>
    <!-- Engine gradient -->
    <linearGradient id="engineGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#3a3a3a"/>
      <stop offset="100%" stop-color="#1a1a1a"/>
    </linearGradient>
  </defs>

  <!-- Shadow under mower -->
  <ellipse cx="105" cy="132" rx="70" ry="6" fill="rgba(0,0,0,0.3)"/>

  <!-- Grass discharge chute (rear left) -->
  <path d="M 30 75 L 15 85 L 15 105 L 35 100 L 35 80 Z" fill="url(#grassGrad)" stroke="#2a5a18" stroke-width="1"/>
  <path d="M 18 88 L 18 102" stroke="#3d7a28" stroke-width="1" stroke-dasharray="2,2"/>

  <!-- Main deck — curved, realistic shape -->
  <path
    d="M 40 70
       Q 40 55, 70 50
       L 150 50
       Q 175 55, 175 70
       L 175 90
       Q 175 100, 150 102
       L 55 102
       Q 40 100, 40 90
       Z"
    fill="#d64040" stroke="#a02020" stroke-width="1.5"
  />

  <!-- Deck highlight strip -->
  <path d="M 50 58 L 160 58" stroke="#e86060" stroke-width="2" stroke-linecap="round"/>

  <!-- Deck label area -->
  <rect x="85" y="62" width="45" height="14" rx="2" fill="#b03030"/>
  <text x="107" y="73" font-family="Arial, sans-serif" font-size="8" font-weight="bold" fill="#fff" text-anchor="middle">MOWER</text>

  <!-- Blade housing (underneath deck) -->
  <ellipse cx="107" cy="100" rx="55" ry="8" fill="#2a2a2a" stroke="#1a1a1a" stroke-width="1"/>

  <!-- Front axle -->
  <rect x="145" y="98" width="25" height="6" rx="2" fill="url(#metalSheen)"/>

  <!-- Rear axle -->
  <rect x="45" y="98" width="25" height="6" rx="2" fill="url(#metalSheen)"/>

  <!-- Engine block -->
  <rect x="120" y="28" width="45" height="30" rx="4" fill="url(#engineGrad)" stroke="#0a0a0a" stroke-width="1"/>

  <!-- Engine cooling fins -->
  <g stroke="#4a4a4a" stroke-width="1">
    <line x1="125" y1="32" x2="160" y2="32"/>
    <line x1="125" y1="37" x2="160" y2="37"/>
    <line x1="125" y1="42" x2="160" y2="42"/>
    <line x1="125" y1="47" x2="160" y2="47"/>
    <line x1="125" y1="52" x2="160" y2="52"/>
  </g>

  <!-- Air filter housing -->
  <rect x="125" y="18" width="20" height="14" rx="3" fill="#222" stroke="#444" stroke-width="1"/>
  <rect x="128" y="20" width="14" height="4" rx="1" fill="#333"/>

  <!-- Fuel tank -->
  <path d="M 148 18 Q 155 15, 162 18 L 162 28 L 148 28 Z" fill="#1a1a1a" stroke="#333" stroke-width="1"/>
  <rect x="152" y="12" width="6" height="8" rx="2" fill="#2a2a2a" stroke="#444" stroke-width="0.5"/>

  <!-- Spark plug cap -->
  <rect x="138" y="22" width="6" height="10" rx="1" fill="#cc4400" stroke="#993300" stroke-width="0.5"/>
  <path d="M 141 22 L 141 16" stroke="#333" stroke-width="1.5"/>

  <!-- Muffler -->
  <ellipse cx="170" cy="45" rx="8" ry="5" fill="#3a3a3a" stroke="#2a2a2a" stroke-width="1"/>
  <ellipse cx="178" cy="45" rx="3" ry="4" fill="#1a1a1a"/>

  <!-- Ripcord housing (on engine, angled toward handle) -->
  <circle cx="155" cy="42" r="6" fill="#2a2a2a" stroke="#444" stroke-width="1"/>
  <circle cx="155" cy="42" r="3" fill="#1a1a1a"/>

  <!-- Handle mount plate -->
  <rect x="165" y="48" width="12" height="18" rx="2" fill="#333" stroke="#222" stroke-width="1"/>

  <!-- Handle — tubular, angled up and back -->
  <g stroke-linecap="round" stroke-linejoin="round">
    <!-- Lower handle tubes -->
    <path d="M 170 52 L 195 30" stroke="#555" stroke-width="5"/>
    <path d="M 170 60 L 195 38" stroke="#555" stroke-width="5"/>

    <!-- Cross brace -->
    <path d="M 188 32 L 188 42" stroke="#666" stroke-width="3"/>

    <!-- Upper handle bar -->
    <path d="M 193 28 L 220 28" stroke="#666" stroke-width="6"/>

    <!-- Rubber grips -->
    <path d="M 205 28 L 218 28" stroke="#222" stroke-width="7" stroke-linecap="round"/>

    <!-- Bail bar (safety lever) -->
    <path d="M 195 26 Q 207 15, 218 26" stroke="#777" stroke-width="2" fill="none"/>
  </g>

  <!-- Throttle/controls on handle -->
  <rect x="196" y="30" width="8" height="5" rx="1" fill="#d64040" stroke="#a02020" stroke-width="0.5"/>

  <!-- Left wheel (rear) — larger -->
  <g>
    <circle cx="58" cy="110" r="22" fill="url(#tread)" stroke="#333" stroke-width="2"/>
    <circle cx="58" cy="110" r="16" fill="none" stroke="#2a2a2a" stroke-width="3"/>
    <circle cx="58" cy="110" r="8" fill="#3a3a3a" stroke="#555" stroke-width="1.5"/>
    <circle cx="58" cy="110" r="3" fill="#222"/>
    <!-- Wheel spokes hint -->
    <g stroke="#444" stroke-width="1">
      <line x1="58" y1="94" x2="58" y2="100"/>
      <line x1="58" y1="120" x2="58" y2="126"/>
      <line x1="42" y1="110" x2="48" y2="110"/>
      <line x1="68" y1="110" x2="74" y2="110"/>
    </g>
  </g>

  <!-- Right wheel (front) — slightly smaller -->
  <g>
    <circle cx="158" cy="112" r="18" fill="url(#tread)" stroke="#333" stroke-width="2"/>
    <circle cx="158" cy="112" r="13" fill="none" stroke="#2a2a2a" stroke-width="2.5"/>
    <circle cx="158" cy="112" r="6" fill="#3a3a3a" stroke="#555" stroke-width="1"/>
    <circle cx="158" cy="112" r="2.5" fill="#222"/>
    <!-- Wheel spokes hint -->
    <g stroke="#444" stroke-width="1">
      <line x1="158" y1="98" x2="158" y2="103"/>
      <line x1="158" y1="121" x2="158" y2="126"/>
      <line x1="144" y1="112" x2="149" y2="112"/>
      <line x1="167" y1="112" x2="172" y2="112"/>
    </g>
  </g>

  <!-- Height adjustment lever (front) -->
  <path d="M 168 95 L 175 85" stroke="#666" stroke-width="2" stroke-linecap="round"/>
  <circle cx="175" cy="85" r="3" fill="#444"/>
</svg>
