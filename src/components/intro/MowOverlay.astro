---
import LawnmowerSvg from "./LawnmowerSvg.astro";

interface Props {
  stripCount?: number;
}

const { stripCount = 10 } = Astro.props;
---

<div id="mow-overlay">

  <!-- Black strips — each gets its clip-path shrunk as the mower passes -->
  <div id="strips" aria-hidden="true">
    {Array.from({ length: stripCount }, () => (
      <div class="strip"></div>
    ))}
  </div>

  <!-- Moving mower — positioned by JS during traversal, hidden at start -->
  <div id="mower-el" aria-hidden="true">
    <LawnmowerSvg />
  </div>

  <!-- Title + pullcord: centered on screen, fades out when mowing starts -->
  <div id="intro-content">
    <h1 class="brand-name">tallboy landscapes</h1>

    <div id="mower-static-wrap">
      <!-- Static mower for pullcord interaction -->
      <div id="mower-static">
        <LawnmowerSvg />
      </div>

      <!-- Pullcord anchored near the engine pullcord hole in the SVG -->
      <div id="cord-wrap">
        <div id="cord-line"></div>
        <div id="cord-handle" role="button" aria-label="Pull the cord to start the mower" tabindex="0">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="7" width="14" height="6" rx="3"/>
            <line x1="10" y1="1" x2="10" y2="7"/>
          </svg>
        </div>
      </div>
    </div>

    <p id="pull-hint">pull the cord</p>
  </div>

</div>

<style>
  #mow-overlay {
    position: fixed;
    inset: 0;
    z-index: 10;
  }

  #mow-overlay.done { pointer-events: none; }

  #strips {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }

  .strip {
    flex: 1;
    background: #000;
    /* clip-path driven by JS as mower passes */
  }

  #mower-el {
    position: absolute;
    pointer-events: auto;
    z-index: 2;
    display: none;
    width: 180px;
    cursor: pointer;
  }

  /* ═══ Secondary elements: retract INTO body center then disappear ═══ */
  @keyframes retract-left {
    0%   { opacity: 1; transform: translate(0, 0) scale(1); }
    70%  { opacity: 0.8; transform: translate(40px, -15px) scale(0.5); }
    100% { opacity: 0; transform: translate(50px, -20px) scale(0.3); }
  }
  @keyframes retract-right {
    0%   { opacity: 1; transform: translate(0, 0) scale(1); }
    70%  { opacity: 0.8; transform: translate(-40px, -15px) scale(0.5); }
    100% { opacity: 0; transform: translate(-50px, -20px) scale(0.3); }
  }
  @keyframes retract-center {
    0%   { opacity: 1; transform: translate(0, 0) scale(1); }
    70%  { opacity: 0.8; transform: translate(0, -10px) scale(0.5); }
    100% { opacity: 0; transform: translate(0, -15px) scale(0.3); }
  }

  /* ═══ Fins emerge OUT ═══ */
  @keyframes fins-emerge {
    0%   { opacity: 0; transform: scale(0.3); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* ═══ Flames ignite — static position, just fade in ═══ */
  @keyframes flames-ignite {
    0%   { opacity: 0; }
    100% { opacity: 1; }
  }

  #mower-el svg {
    width: 100%;
    display: block;
  }

  #intro-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    z-index: 3;
    transition: opacity 0.5s ease;
  }

  #intro-content.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  .brand-name {
    font-family: "PlayfairDisplayLocal", serif;
    font-size: clamp(1.8rem, 6vw, 4rem);
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.02em;
    text-align: center;
  }

  #mower-static-wrap {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }

  #mower-static {
    width: 160px;
  }

  #mower-static.shake { animation: mower-shake 0.5s ease; }
  #mower-el.mowing { animation: mower-shake 0.15s infinite; }

  @keyframes mower-shake {
    0%   { transform: translateX(0) rotate(0deg); }
    15%  { transform: translateX(-5px) rotate(-1.5deg); }
    35%  { transform: translateX(5px) rotate(1.5deg); }
    55%  { transform: translateX(-4px) rotate(-1deg); }
    75%  { transform: translateX(4px) rotate(1deg); }
    90%  { transform: translateX(-2px) rotate(-0.5deg); }
    100% { transform: translateX(0) rotate(0deg); }
  }

  /* Pullcord positioned at ripcord housing (155,42) in 240×140 viewBox — angled to match handle */
  #cord-wrap {
    position: absolute;
    top: 28%;
    left: 64%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transform: rotate(250deg);
    transform-origin: top left;
  }

  #cord-line {
    width: 2px;
    height: 28px;
    background: linear-gradient(to bottom, #777, #aaa);
    border-radius: 1px;
    transition: height 0.08s linear;
  }

  #cord-handle {
    width: 34px;
    height: 34px;
    border-radius: 7px;
    background: #2a2a2a;
    border: 2px solid #666;
    color: #aaa;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    touch-action: none;
    user-select: none;
    margin-left: -16px;
  }

  #cord-handle:active { cursor: grabbing; background: #3a3a3a; }
  #cord-handle:focus-visible { outline: 2px solid #888; outline-offset: 2px; }

  #pull-hint {
    font-family: "InterLocal", sans-serif;
    font-size: 0.8rem;
    color: #666;
    letter-spacing: 0.1em;
    animation: hint-pulse 2s ease-in-out infinite;
    pointer-events: none;
  }

  #pull-hint.hidden { visibility: hidden; }

  @keyframes hint-pulse {
    0%, 100% { opacity: 0.3; }
    50%       { opacity: 1; }
  }
</style>

<script is:inline define:vars={{ stripCount }}>
  // ── Phase 1: Pullcord ─────────────────────────────────────
  const cordHandle   = document.getElementById("cord-handle");
  const cordLine     = document.getElementById("cord-line");
  const mowerStatic  = document.getElementById("mower-static");
  const introContent = document.getElementById("intro-content");
  const overlay      = document.getElementById("mow-overlay");
  const pullHint     = document.getElementById("pull-hint");
  const mowerEl      = document.getElementById("mower-el");
  const strips       = Array.from(document.querySelectorAll(".strip"));

  let pulling    = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let pullDist   = 0;
  let mowStarted = false;

  const PULL_TRIGGER = 60;
  const MAX_EXT      = 110;

  // Pull axis: 250deg CSS rotation = 160deg in screen coords (left + slightly down)
  const PULL_ANGLE = (250 + 90) * Math.PI / 180; // radians
  const PULL_DX = Math.cos(PULL_ANGLE); // ≈ -0.94
  const PULL_DY = Math.sin(PULL_ANGLE); // ≈ 0.34

  const getX = (e) => "touches" in e ? e.touches[0].clientX : e.clientX;
  const getY = (e) => "touches" in e ? e.touches[0].clientY : e.clientY;

  cordHandle.addEventListener("mousedown", e => {
    if (mowStarted) return;
    pulling = true;
    dragStartX = getX(e);
    dragStartY = getY(e);
    pullHint.classList.add("hidden");
    e.preventDefault();
  });

  cordHandle.addEventListener("touchstart", e => {
    if (mowStarted) return;
    pulling = true;
    dragStartX = getX(e);
    dragStartY = getY(e);
    pullHint.classList.add("hidden");
  }, { passive: true });

  const handleCordMove = (e) => {
    if (!pulling) return;
    const dx = getX(e) - dragStartX;
    const dy = getY(e) - dragStartY;
    // Project movement onto pull axis
    const projected = dx * PULL_DX + dy * PULL_DY;
    pullDist = Math.max(0, Math.min(projected, MAX_EXT));
    cordLine.style.height = `${28 + pullDist}px`;
  };

  window.addEventListener("mousemove", handleCordMove);
  window.addEventListener("touchmove", handleCordMove, { passive: true });

  const onRelease = () => {
    if (!pulling) return;
    pulling = false;
    cordLine.style.height = "28px";
    if (pullDist >= PULL_TRIGGER && !mowStarted) {
      mowStarted = true;
      // Cord is pulled — remove all window listeners, they're no longer needed
      window.removeEventListener("mousemove", handleCordMove);
      window.removeEventListener("touchmove", handleCordMove);
      window.removeEventListener("mouseup", onRelease);
      window.removeEventListener("touchend", onRelease);
      mowerStatic.classList.add("shake");
      mowerStatic.addEventListener("animationend", () => {
        mowerStatic.classList.remove("shake");
        startMowing();
      }, { once: true });
    }
    pullDist = 0;
  };

  window.addEventListener("mouseup", onRelease);
  window.addEventListener("touchend", onRelease);

  // ── Phase 2: Mower traversal ──────────────────────────────
  function startMowing() {
    introContent.classList.add("fade-out");
    mowerEl.style.display = "block";
    setTimeout(runMower, 400);
  }

  function runMower() {
    let SPEED_PX = 6; // pixels per frame — consistent feel across screen sizes
    const viewportW = window.innerWidth;
    const viewportH = window.innerHeight;
    const stripH = viewportH / stripCount;

    let row            = 0;
    let xPos           = 0;
    let goingRight     = true;
    let isPaused       = false;
    let hasTransformed = false;

    const mowerW  = 180; // wider hitbox for clicking while mowing
    const mowerH  = mowerW * (140 / 240); // aspect ratio from viewBox
    const mowerSvg = mowerEl.querySelector("svg");

    mowerEl.classList.add("mowing");

    const applyRetract = (els, animName, duration, delay) => {
      els.forEach(el => {
        if (!el) return;
        el.style.transformOrigin = "center center";
        el.style.animation = `${animName} ${duration} ease-in forwards`;
        el.style.animationDelay = delay;
      });
    };

    const transformToRocket = () => {
      if (!mowerSvg) return;

      mowerEl.classList.remove("mowing");

      const TRANSFORM_DURATION = 1.5;
      const retractDelay    = `${TRANSFORM_DURATION * 0.2}s`;
      const retractDuration = `${TRANSFORM_DURATION * 0.4}s`;
      const finsDelay       = `${TRANSFORM_DURATION * 0.5}s`;
      const finsDuration    = `${TRANSFORM_DURATION * 0.3}s`;

      const parts = {
        handle:       mowerSvg.getElementById("mower-handle"),
        fins:         mowerSvg.getElementById("rocket-fins"),
        flames:       mowerSvg.getElementById("rocket-flames"),
        deck:         mowerSvg.getElementById("mower-deck"),
        wheelLeft:    mowerSvg.getElementById("mower-wheel-left"),
        wheelRight:   mowerSvg.getElementById("mower-wheel-right"),
        chute:        mowerSvg.getElementById("mower-chute"),
        lever:        mowerSvg.getElementById("mower-height-lever"),
        engineBlock:  mowerSvg.getElementById("engine-block"),
        engineParts:  mowerSvg.getElementById("mower-engine-parts"),
        engineDetails:mowerSvg.getElementById("mower-engine-details"),
        bladeHousing: mowerSvg.getElementById("mower-blade-housing"),
        frontAxle:    mowerSvg.getElementById("mower-front-axle"),
        rearAxle:     mowerSvg.getElementById("mower-rear-axle"),
        deckHighlight:mowerSvg.getElementById("mower-deck-highlight"),
        deckLabel:    mowerSvg.getElementById("mower-deck-label"),
      };

      // SVG stacks by document order — reorder so deck → nose → label render on top
      if (parts.deck)     mowerSvg.appendChild(parts.deck);
      if (parts.chute)    mowerSvg.appendChild(parts.chute);
      if (parts.deckLabel)mowerSvg.appendChild(parts.deckLabel);

      mowerSvg.getElementById("deck-to-rocket")?.beginElement();
      mowerSvg.getElementById("deck-color-change")?.beginElement();
      mowerSvg.getElementById("chute-to-nose")?.beginElement();
      mowerSvg.getElementById("chute-detail-fade")?.beginElement();

      applyRetract([parts.wheelLeft, parts.rearAxle],                                         "retract-right",  retractDuration, retractDelay);
      applyRetract([parts.wheelRight, parts.handle, parts.lever, parts.frontAxle],            "retract-left",   retractDuration, retractDelay);
      applyRetract([parts.engineBlock, parts.engineParts, parts.engineDetails,
                    parts.bladeHousing, parts.deckHighlight],                                  "retract-center", retractDuration, retractDelay);

      if (parts.fins) {
        parts.fins.style.transformOrigin = "right center";
        parts.fins.style.animation = `fins-emerge ${finsDuration} ease-out forwards`;
        parts.fins.style.animationDelay = finsDelay;
      }

      // Flames ignite right as the rocket resumes movement
      if (parts.flames) {
        parts.flames.style.animation = `flames-ignite 0.3s ease-out forwards`;
        parts.flames.style.animationDelay = `${TRANSFORM_DURATION}s`;
      }

      setTimeout(() => {
        SPEED_PX *= 2;
        isPaused = false;
      }, TRANSFORM_DURATION * 1000);
    };

    const handleMowerClick = () => {
      if (hasTransformed) return;
      hasTransformed = true;
      isPaused = true;
      mowerEl.classList.add("rocket");
      transformToRocket();
    };

    mowerEl.addEventListener("click", handleMowerClick);

    const positionMower = () => {
      const x = goingRight ? xPos : viewportW - xPos;
      mowerEl.style.left = `${x - mowerW / 2}px`;
      mowerEl.style.top  = `${(row + 1) * stripH - mowerH}px`;
      // Flip the SVG, not the container (shake animation uses transform on container)
      if (mowerSvg) mowerSvg.style.transform = goingRight ? "scaleX(-1)" : "scaleX(1)";
    };

    const updateStrip = () => {
      const strip = strips[row];
      if (!strip) return;
      const pct = (xPos / viewportW) * 100;
      strip.style.clipPath = goingRight
        ? `inset(0 0 0 ${pct}%)`
        : `inset(0 ${pct}% 0 0)`;
    };

    const tick = () => {
      if (!isPaused) {
        xPos += SPEED_PX;

        if (xPos >= viewportW) {
          strips[row].style.clipPath = "inset(0 0 0 100%)";
          row++;

          if (row >= stripCount) {
            mowerEl.style.display = "none";
            mowerEl.removeEventListener("click", handleMowerClick);
            mowerEl.classList.remove("mowing", "rocket");
            overlay.classList.add("done");
            return;
          }

          goingRight = !goingRight;
          xPos = 0;
        }

        updateStrip();
        positionMower();
      }

      requestAnimationFrame(tick);
    };

    positionMower();
    requestAnimationFrame(tick);
  }
</script>
