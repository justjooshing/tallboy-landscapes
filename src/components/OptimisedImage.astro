---
import { transformProps } from "@unpic/core";
import type { HTMLAttributes } from "astro/types";
import { toHttps } from "../lib/url";

interface Props {
  src: string;
  alt: string;
  className?: string;
  priority?: boolean;
}

const { src, alt, className, priority = false } = Astro.props;

const secureSrc = toHttps(src) || src;

const imgProps = transformProps<HTMLAttributes<"img">>({
  src: secureSrc,
  alt,
  priority,
  decoding: "async",
  layout: "fullWidth",
  cdn: "contentful",
});

const placeholder = secureSrc.includes("ctfassets.net")
  ? `${secureSrc}?w=24&q=20`
  : undefined;
---

<div
  class="image-wrapper"
  style={placeholder ? `--placeholder: url("${placeholder}")` : undefined}
>
  <img {...imgProps} class={className} />
</div>

<style>
  .image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    background-image: var(--placeholder);
    background-size: cover;
    background-position: center;
    img {
      position: relative;
      height: 100%;
    }
  }
</style>
