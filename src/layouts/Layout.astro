---
import { schema, facebookPage, instagramPage } from "../constants/schema.js";
import Header from "../components/Header.astro";

const {
  title,
  description = "Professional landscapes services transforming outdoor spaces",
} = Astro.props;

const url = `${Astro.site}${Astro.url.pathname}`;
const image = "https://www.tallboylandscapes.com/images/tallboylandscapes.jpg";

// We don't want the preview site to be indexed
const site = typeof Astro.site === "string" ? Astro.site : Astro.site?.href;
const isPreview = site === "https://preview.tallboylandscapes.com/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Must be inlined to run before rendering
      const stored = localStorage.getItem("theme");
      const preferred = window.matchMedia("(prefers-color-scheme: dark)")
        .matches
        ? "dark"
        : "light";
      document.documentElement.setAttribute("data-theme", stored ?? preferred);
    </script>
    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
      sizes="32x32"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-light.png"
      sizes="32x32"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="preload"
      href="/fonts/Inter-VariableFont_opsz,wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/PlayfairDisplay-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content="en_AU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="canonical" href={url} />
    <link rel="me" href={facebookPage} />
    <link rel="me" href={instagramPage} />
    <meta name="generator" content={Astro.generator} />
    {
      isPreview ? (
        <meta name="robots" content="noindex,nofollow" />
      ) : (
        <link rel="sitemap" href="/sitemap-index.xml" />
      )
    }
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>

<script>
  const unlock = () => {
    localStorage.setItem("intro-unlocked", "1");
    window.location.href = "/intro";
  };

  // Desktop: type "mynameisotis"
  const SECRET = "mynameisotis";
  let buffer = "";
  window.addEventListener("keydown", e => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    buffer = (buffer + e.key).slice(-SECRET.length);
    if (buffer === SECRET) { buffer = ""; unlock(); }
  });

  // Mobile: tap the footer copyright 7 times within 2 seconds
  const TAP_TARGET = 7;
  const TAP_WINDOW = 2000;
  let taps = 0;
  let tapTimer: ReturnType<typeof setTimeout> | null = null;

  const copyright = document.getElementById("footer-copyright");
  document.addEventListener("click", e => {
    if (!copyright?.contains(e.target as Node)) return;
    taps++;
    if (tapTimer) clearTimeout(tapTimer);
    tapTimer = setTimeout(() => { taps = 0; }, TAP_WINDOW);
    if (taps >= TAP_TARGET) { taps = 0; unlock(); }
  });
</script>

<style is:global>
  @import "../styles/global.css";
</style>
