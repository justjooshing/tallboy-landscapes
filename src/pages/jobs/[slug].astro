---
import Layout from "../../layouts/Layout.astro";
import ContactFooter from "../../components/ContactFooter.astro";
import { getJobs } from "../../lib/jobs/index";
import OptimisedImage from '../../components/OptimisedImage.astro';
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

export const prerender = true;

export const getStaticPaths = (async () => {
  const jobs = await getJobs();
  return jobs.map((job) => ({
    params: { slug: job.fields.slug },
    props: { job, jobs },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { job, jobs } = Astro.props;
const { slug } = Astro.params;

const { title, location, showcaseImage, descriptions, images, relatedServices } = job.fields;

interface Content {
  description?: { content: string };
  image?: { url: string; alt: string };
}

const contentSections: Content[] = [];

if (descriptions && images) {
  const descriptionSections = descriptions
    .split("\n\n")
    .reduce((acc: string[], desc) => {
      const trimmedDesc = desc.trim();
      if (trimmedDesc) {
        acc.push(trimmedDesc);
      }
      return acc;
    }, []);

  const maxLength = Math.max(descriptionSections.length, images.length);
  for (let i = 0; i < maxLength; i++) {
    const description = descriptionSections[i];
    const image = images[i];
    contentSections.push({
      ...(description && {
        description: { content: description },
      }),
      ...(image && {
        image: {
          url: image.fields.file?.url || "",
          alt: image.fields.title || `${title} - Image ${i + 1}`,
        },
      }),
    });
  }
}

// Previous / Next navigation (loops)
const currentIndex = jobs.findIndex((j) => j.fields.slug === slug);
const total = jobs.length || 1;
const prevIndex = (currentIndex - 1 + total) % total;
const nextIndex = (currentIndex + 1) % total;
const navigate = (index: number) => jobs[index]?.fields?.slug || slug;
const prevSlug = navigate(prevIndex);
const nextSlug = navigate(nextIndex);

---
<Layout
  title={`${title} - Tallboy Landscapes`}
  description={`${title} project in ${location}`}
>
  <main>
    <!-- Hero Section -->
    <section class="job-hero">
      <div class="job-hero-image-wrapper">
        <OptimisedImage
          src={showcaseImage?.fields.file?.url ||
            "/placeholder.svg?height=600&width=1600&query=landscaping project"}
          alt={title}
          className="job-hero-image"
          priority
        />
        <div class="job-hero-overlay"></div>
      </div>
      <div class="job-hero-content">
        <div class="container">
          <h1 class="job-title">{title}</h1>
          <p class="job-location">{location}</p>
        </div>
      </div>
    </section>

    <!-- Project Details -->
    <section class="job-details">
      <div class="container">
        {
          contentSections.map(({ description, image }, index) => (
            <div class:list={["content-section", { reverse: index % 2 === 0,  singleColumn: !description || !image}]}>
              {description ? (
                <div class="text-content">
                  <p>{description.content}</p>
                </div>
              ) : null}
              {image ? (
                <div class="image-content">
                  <OptimisedImage
                    src={image?.url || "/placeholder.svg"}
                    alt={image?.alt}
                  />
                </div>
              ) : null}
            </div>
          ))
        }
      </div>
    </section>
    {
      total > 1 ?
       <section class="job-nav">
      <div class="container">
        <div class="job-nav-inner">
          <a class="job-nav-btn prev" href={`/jobs/${prevSlug}`}>← Previous</a>
          <a class="job-nav-btn next" href={`/jobs/${nextSlug}`}>Next →</a>
        </div>
      </div>
    </section>
   : null }

   <!-- Services Featured Section -->
   {relatedServices && relatedServices.length > 0 && (
     <section class="services-featured">
       <div class="container">
         <h2 class="section-title">Services featured in this project</h2>
         <div class="services-grid">
           {relatedServices.map((service) => (
             service && service.sys && service.fields && (
               <a href={`/services/${service.normalisedTitle}`} class="service-card">
                 <div class="service-icon">{service.fields.icon || "🌿"}</div>
                 <h3>{service.fields.title}</h3>
                 <p>{service.fields.description}</p>
               </a>
             )
           ))}
         </div>
       </div>
     </section>
   )}

   <!-- Contact Section -->
    <ContactFooter />
  </main>
</Layout>

<style>
  /* Job Hero Section */
  .job-hero {
    position: relative;
    height: 70vh;
    min-height: 500px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .job-hero-image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .job-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .job-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--color-overlay-start),
      var(--color-overlay-end)
    );
  }

  .job-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    color: var(--color-on-primary);
    padding: 3rem 0;
  }

  .job-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    text-wrap: balance;
  }

  .job-location {
    font-size: 1.25rem;
    opacity: 0.95;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .job-location::before {
    content: "📍";
  }

  /* Job Details Section */
  .job-details {
    padding: 2rem 0;
    background: var(--color-surface);

    .container {
      display: flex;
      flex-direction: column;
      gap: 2em;
    }
  }

  .content-section {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .text-content {
    padding: 2rem;
    background: var(--color-surface-tinted);
    border-radius: 8px;
    height: 100%;
  }

  .text-content p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .image-content {
    height: 100%
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 40px var(--color-shadow);
  }

  .image-content img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 768px) {
    .job-title {
      font-size: 3.5rem;
    }

    .job-location {
      font-size: 1.5rem;
    }

    .content-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .content-section.reverse {
      direction: rtl;
    }

    .content-section.reverse > * {
       direction: ltr;
    }

    .singleColumn {
      grid-template-columns: 1fr 
    }

    .text-content {
      padding: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .job-title {
      font-size: 4rem;
    }

    .content-section {
      gap: 4rem;
      margin-bottom: 4rem;
    }
  }

  .job-nav {
    padding: 1rem 0;
    background: var(--color-surface);
  }

  .job-nav-inner {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    padding: 0.5rem 0;
  }

  .job-nav-btn {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    border-radius: 6px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .job-nav-btn.prev {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border-muted);
  }

  .job-nav-btn.next {
    background: var(--color-primary);
  }

  /* Services Featured Section */
  .services-featured {
    padding: 3rem 0;
    background: var(--color-surface-tinted);
  }

  .services-featured .section-title {
    text-align: center;
    margin-bottom: 2rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .services-featured .service-card {
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
    border: 1px solid var(--color-border-muted);
  }

  .services-featured .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px var(--color-shadow);
    border-color: var(--color-primary);
  }

  .services-featured .service-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .services-featured .service-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-heading);
  }

  .services-featured .service-card p {
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
