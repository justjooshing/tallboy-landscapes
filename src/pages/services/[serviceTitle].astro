---
import Layout from "../../layouts/Layout.astro";
import ContactFooter from "../../components/ContactFooter.astro";
import { getJobsByServiceId } from "../../lib/jobs/index";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getServices } from "../../lib/services";
import ProjectCard from "../../components/ProjectCard.astro";

export const prerender = true;

export const getStaticPaths = (async () => {
  const services = await getServices();
  if (!services) return [];

  return services.map((service) => ({
    params: { serviceTitle: service.normalisedTitle },
    props: { service }
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { service } = Astro.props;
const jobs = await getJobsByServiceId(service.sys.id);
---

<Layout title={`${service.fields.title} - Tallboy Landscapes`}>
  <main>
    <section class="service-header">
      <div class="container">
        <h1 class="service-title">{service.fields.title}</h1>
        <p class="service-description">{service.fields.description}</p>
      </div>
    </section>

    {jobs.length > 0 ? (
      <section class="service-jobs">
        <div class="container">
          <h2 class="section-title">Projects featuring this service</h2>
          <div class="projects-grid">
            {jobs.map((job) => (
              <ProjectCard job={job} />
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="no-jobs">
        <div class="container">
          <p>No projects found for this service yet. Check back soon!</p>
        </div>
      </section>
    )}

    <ContactFooter />
  </main>
</Layout>

<style>
  .service-header {
    padding: 4rem 0;
    background: var(--color-surface-tinted);
    text-align: center;
  }

  .service-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-heading);
  }

  .service-description {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--color-text);
    max-width: 800px;
    margin: 0 auto;
  }

  .service-jobs {
    padding: 5rem 0;
    background: var(--color-surface);
  }

  .section-title {
    font-size: 2.25rem;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--color-heading);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .no-jobs {
    text-align: center;
    padding: 4rem 0;
    background: var(--color-surface-tinted);
  }

  .no-jobs p {
    font-size: 1.25rem;
    color: var(--color-text);
    max-width: 600px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .service-title {
      font-size: 3.5rem;
    }

    .service-description {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .service-title {
      font-size: 4.5rem;
    }

    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
